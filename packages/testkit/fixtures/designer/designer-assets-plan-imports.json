      "kind": "vanilla-defs",
      "action": "create",
      "rendered": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<Defs>\n  <!-- ====== DM_Carbine_Shot ====== -->\n  <SoundDef>\n    <defName>DM_Carbine_Shot</defName>\n    <context>MapOnly</context>\n    <maxSimultaneous>3</maxSimultaneous>\n    <subSounds>\n      <li>\n        <grains>\n          <li Class=\"AudioGrain_Clip\">\n            <clipPath>Weapons/DM_Carbine_Shot/TLWWP_Glock_17_Shot</clipPath>\n          </li>\n          <li Class=\"AudioGrain_Clip\">\n            <clipPath>Weapons/DM_Carbine_Shot/TLWWP_AK_47_Shot</clipPath>\n          </li>\n        </grains>\n        <volumeRange>45~55</volumeRange>\n        <pitchRange>0.95~1.05</pitchRange>\n        <distRange>40~60</distRange>\n      </li>\n    </subSounds>\n  </SoundDef>\n</Defs>\n",

    {
      "path": "Defs/ThingDefs_Misc/Weapons/RangedIndustrial/UC_PlatformRifle.xml",
      "kind": "vanilla-defs",
      "action": "unchanged",
      "rendered": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<Defs>\n  <!-- ====== Bullet_UC_PlatformRifle ====== -->\n  <ThingDef ParentName=\"BaseBullet\">\n    <defName>Bullet_UC_PlatformRifle</defName>\n    <label>bolt-action rifle bullet</label>\n    <graphicData>\n      <texPath>Things/Projectile/Bullet_big</texPath>\n      <graphicClass>Graphic_Single</graphicClass>\n    </graphicData>\n    <projectile>\n      <damageDef>Bullet</damageDef>\n      <damageAmountBase>18</damageAmountBase>\n      <stoppingPower>1.5</stoppingPower>\n      <speed>70</speed>\n    </projectile>\n  </ThingDef>\n  <!-- ====== UC_PlatformRifle ====== -->\n  <ThingDef ParentName=\"BaseHumanMakeableGun\">\n    <defName>UC_PlatformRifle</defName>\n    <label>uc platform rifle</label>\n    <description>An ancient pattern bolt-action rifle. With its long range, and low fire rate, it is unlikely to drive animals to revenge, which makes it a favorite weapon for hunting.</description>\n    <graphicData>\n      <texPath>Things/Item/Equipment/WeaponRanged/BoltActionRifle</texPath>\n      <graphicClass>Graphic_Single</graphicClass>\n    </graphicData>\n    <statBases>\n      <WorkToMake>12000</WorkToMake>\n      <Mass>3.5</Mass>\n      <AccuracyTouch>0.65</AccuracyTouch>\n      <AccuracyShort>0.8</AccuracyShort>\n      <AccuracyMedium>0.9</AccuracyMedium>\n      <AccuracyLong>0.8</AccuracyLong>\n      <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>\n    </statBases>\n    <costList>\n      <Steel>60</Steel>\n      <ComponentIndustrial>3</ComponentIndustrial>\n    </costList>\n    <recipeMaker>\n      <skillRequirements>\n        <Crafting>5</Crafting>\n      </skillRequirements>\n      <displayPriority>415</displayPriority>\n    </recipeMaker>\n    <soundInteract>Interact_Rifle</soundInteract>\n    <verbs>\n      <li>\n        <verbClass>Verb_Shoot</verbClass>\n        <hasStandardCommand>true</hasStandardCommand>\n        <defaultProjectile>Bullet_UC_PlatformRifle</defaultProjectile>\n        <warmupTime>1.7</warmupTime>\n        <range>36.9</range>\n        <soundCast>Shot_BoltActionRifle</soundCast>\n        <soundCastTail>GunTail_Heavy</soundCastTail>\n        <muzzleFlashScale>9</muzzleFlashScale>\n      </li>\n    </verbs>\n    <tools>\n      <li>\n        <label>stock</label>\n        <capacities>\n          <li>Blunt</li>\n        </capacities>\n        <power>9</power>\n        <cooldownTime>2</cooldownTime>\n      </li>\n      <li>\n        <label>barrel</label>\n        <capacities>\n          <li>Blunt</li>\n          <li>Poke</li>\n        </capacities>\n        <power>9</power>\n        <cooldownTime>2</cooldownTime>\n      </li>\n    </tools>\n    <weaponClasses>\n      <li>LongShots</li>\n    </weaponClasses>\n  </ThingDef>\n</Defs>\n",
      "bytes": 2663
    },
    {
      "path": "Compat/CombatExtended/Patches/platform_Weapons_Ranged.xml",
      "kind": "ce-patch",
      "action": "create",
      "rendered": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<Patch>\n  <!-- ====== UC_PlatformRifle ====== generated by RimStudio, draft UC_PlatformRifle -->\n  <Operation Class=\"PatchOperationConditional\">\n    <xpath>Defs/ThingDef[defName=\"UC_PlatformRifle\"]/comps/li[@Class=\"CombatExtended.CompProperties_AmmoUser\"]</xpath>\n    <nomatch Class=\"CombatExtended.PatchOperationMakeGunCECompatible\">\n      <defName>UC_PlatformRifle</defName>\n      <statBases>\n        <Mass>3.5</Mass>\n        <Bulk>5</Bulk>\n        <SwayFactor>1.1</SwayFactor>\n        <ShotSpread>0.2</ShotSpread>\n        <SightsEfficiency>1</SightsEfficiency>\n        <RangedWeapon_Cooldown>0.44</RangedWeapon_Cooldown>\n      </statBases>\n      <Properties>\n        <recoilAmount>1.5</recoilAmount>\n        <recoilPattern>Regular</recoilPattern>\n        <verbClass>CombatExtended.Verb_ShootCE</verbClass>\n        <hasStandardCommand>true</hasStandardCommand>\n        <defaultProjectile>Bullet_303British_FMJ_SB</defaultProjectile>\n        <warmupTime>1.271</warmupTime>\n        <range>38.01</range>\n        <soundCast>Shot_BoltActionRifle</soundCast>\n        <soundCastTail>GunTail_Heavy</soundCastTail>\n        <muzzleFlashScale>9</muzzleFlashScale>\n      </Properties>\n      <AmmoUser>\n        <magazineSize>8</magazineSize>\n        <reloadTime>2</reloadTime>\n        <reloadOneAtATime>true</reloadOneAtATime>\n        <ammoSet>AmmoSet_303British_SB</ammoSet>\n      </AmmoUser>\n      <FireModes>\n        <aiAimMode>AimedShot</aiAimMode>\n      </FireModes>\n      <weaponTags>\n        <li>CE_AI_Rifle</li>\n        <li>CE_AI_AssaultWeapon</li>\n      </weaponTags>\n      <isWeaponPlatform>true</isWeaponPlatform>\n      <attachmentLinks>\n        <li>\n          <attachment>RS_Scope</attachment>\n          <drawScale>(0.5,0.5)</drawScale>\n          <statOffsets>\n            <SightsEfficiency>0.5</SightsEfficiency>\n          </statOffsets>\n        </li>\n      </attachmentLinks>\n      <defaultGraphicParts>\n        <li>\n          <partGraphic>\n            <texPath>Things/Item/Equipment/WeaponRanged/Scope</texPath>\n          </partGraphic>\n          <slotTags>\n            <li>Scope</li>\n          </slotTags>\n        </li>\n      </defaultGraphicParts>\n    </nomatch>\n  </Operation>\n  <Operation Class=\"PatchOperationConditional\">\n    <xpath>Defs/ThingDef[defName=\"UC_PlatformRifle\"]/comps</xpath>\n    <nomatch Class=\"PatchOperationAdd\">\n      <xpath>Defs/ThingDef[defName=\"UC_PlatformRifle\"]</xpath>\n      <value>\n        <comps/>\n      </value>\n    </nomatch>\n  </Operation>\n  <Operation Class=\"PatchOperationConditional\">\n    <xpath>Defs/ThingDef[defName=\"UC_PlatformRifle\"]/comps/li[@Class=\"CombatExtended.CompProperties_UnderBarrel\"]</xpath>\n    <nomatch Class=\"PatchOperationAdd\">\n      <xpath>Defs/ThingDef[defName=\"UC_PlatformRifle\"]/comps</xpath>\n      <value>\n        <li Class=\"CombatExtended.CompProperties_UnderBarrel\">\n          <standardLabel>rifle</standardLabel>\n          <underBarrelLabel>launcher</underBarrelLabel>\n          <requiresReload>true</requiresReload>\n          <propsUnderBarrel>\n            <magazineSize>1</magazineSize>\n            <reloadTime>3</reloadTime>\n            <ammoSet>AmmoSet_25x40mmGrenade</ammoSet>\n          </propsUnderBarrel>\n          <verbPropsUnderBarrel>\n            <verbClass>CombatExtended.Verb_ShootCE</verbClass>\n            <hasStandardCommand>true</hasStandardCommand>\n            <defaultProjectile>Bullet_25x40mmGrenade_HE</defaultProjectile>\n            <warmupTime>1.2</warmupTime>\n            <range>30</range>\n          </verbPropsUnderBarrel>\n          <propsFireModesUnderBarrel>\n            <aiUseBurstMode>false</aiUseBurstMode>\n            <aiAimMode>AimedShot</aiAimMode>\n            <noSingleShot>true</noSingleShot>\n          </propsFireModesUnderBarrel>\n        </li>\n      </value>\n    </nomatch>\n  </Operation>\n  <Operation Class=\"PatchOperationReplace\">\n    <xpath>Defs/ThingDef[defName=\"UC_PlatformRifle\"]/tools</xpath>\n    <value>\n      <tools>\n        <li Class=\"CombatExtended.ToolCE\">\n          <label>stock</label>\n          <capacities>\n            <li>Blunt</li>\n          </capacities>\n          <power>9</power>\n          <chanceFactor>1.5</chanceFactor>\n          <cooldownTime>2</cooldownTime>\n          <armorPenetrationBlunt>1.5</armorPenetrationBlunt>\n          <linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>\n        </li>\n        <li Class=\"CombatExtended.ToolCE\">\n          <label>barrel</label>\n          <capacities>\n            <li>Blunt</li>\n          </capacities>\n          <power>9</power>\n          <cooldownTime>2</cooldownTime>\n          <armorPenetrationBlunt>1.5</armorPenetrationBlunt>\n          <linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>\n        </li>\n        <li Class=\"CombatExtended.ToolCE\">\n          <label>muzzle</label>\n          <capacities>\n            <li>Poke</li>\n          </capacities>\n          <power>9</power>\n          <cooldownTime>2</cooldownTime>\n          <armorPenetrationBlunt>1.5</armorPenetrationBlunt>\n          <linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>\n        </li>\n      </tools>\n    </value>\n  </Operation>\n  <Operation Class=\"PatchOperationConditional\">\n    <xpath>Defs/ThingDef[defName=\"UC_PlatformRifle\"]/li</xpath>\n    <match Class=\"PatchOperationReplace\">\n      <xpath>Defs/ThingDef[defName=\"UC_PlatformRifle\"]/li</xpath>\n      <value>\n        <li Class=\"Example.Thing\">\n          <field>1</field>\n        </li>\n      </value>\n    </match>\n    <nomatch Class=\"PatchOperationAdd\">\n      <xpath>Defs/ThingDef[defName=\"UC_PlatformRifle\"]</xpath>\n      <value>\n        <li Class=\"Example.Thing\">\n          <field>1</field>\n        </li>\n      </value>\n    </nomatch>\n  </Operation>\n</Patch>\n",
      "bytes": 5699
    },

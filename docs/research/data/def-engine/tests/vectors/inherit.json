    "id": "ludeon.rimworld",
    "files": {
     "Defs/a.xml": "<Defs><ThingDef Abstract=\"True\"><defName>A1</defName></ThingDef><ThingDef Abstract=\"true\"><defName>A2</defName></ThingDef><ThingDef Abstract=\"TRUE\"><defName>A3</defName></ThingDef><ThingDef Abstract=\"False\"><defName>Y1</defName></ThingDef><ThingDef abstract=\"true\"><defName>Y2</defName></ThingDef><ThingDef Name=\"P\" Abstract=\"True\"><label>p</label></ThingDef><ThingDef ParentName=\"P\"><defName>Y3</defName></ThingDef></Defs>"
    }
   }

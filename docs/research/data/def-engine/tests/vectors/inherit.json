[
 {
  "name": "inherit-basic-merge",
  "doc": "Child over parent: scalar replaced, nested elements merged by name, li appended, new elements appended at the end; attributes of the parent (Name, Abstract, Foo) are NOT inherited.",
  "game_version": "1.6.4871",
  "mods": [
   {
    "id": "ludeon.rimworld",
    "files": {
     "Defs/a.xml": "<Defs><ThingDef Name=\"Base\" Abstract=\"True\" Foo=\"p\"><defName>BaseX</defName><label>base</label><statBases><MaxHitPoints>100</MaxHitPoints><Mass>2</Mass></statBases><comps><li>a</li></comps></ThingDef><ThingDef ParentName=\"Base\"><defName>C</defName><statBases><Mass>5</Mass></statBases><comps><li>b</li></comps><extra>1</extra></ThingDef></Defs>"
    }
   }
  ],
  "expect": {
   "defs": {
    "ThingDef/C": "<ThingDef ParentName=\"Base\"><defName>C</defName><label>base</label><statBases><MaxHitPoints>100</MaxHitPoints><Mass>5</Mass></statBases><comps><li>a</li><li>b</li></comps><extra>1</extra></ThingDef>"
   },
   "absent": [
    "ThingDef/BaseX"
   ],
   "stats": {
    "abstract": 1,
    "defs": 1
   },
   "provenance": {
    "ThingDef/C": {
     "parents": [
      "ludeon.rimworld:Base"
     ]
    }
   }
  }
 },
 {
  "name": "inherit-allow-duplicate-nodes",
  "doc": "Children of fields marked XmlInheritanceAllowDuplicateNodes (here forcedTraits) are appended like li; the same shape under another name is merged.",
  "game_version": "1.6.4871",
  "mods": [
   {
    "id": "ludeon.rimworld",
    "files": {
     "Defs/a.xml": "<Defs><ThingDef Name=\"P\" Abstract=\"True\"><forcedTraits><Brawler>1</Brawler></forcedTraits><other><Brawler>1</Brawler></other></ThingDef><ThingDef ParentName=\"P\"><defName>C</defName><forcedTraits><Brawler>2</Brawler></forcedTraits><other><Brawler>2</Brawler></other></ThingDef></Defs>"
    }
   }
  ],
  "expect": {
   "defs": {
    "ThingDef/C": "<ThingDef ParentName=\"P\"><forcedTraits><Brawler>1</Brawler><Brawler>2</Brawler></forcedTraits><other><Brawler>2</Brawler></other><defName>C</defName></ThingDef>"
   }
  }
 },
 {
  "name": "inherit-false-nested",
  "doc": "Inherit=\"False\" on a nested node discards the parent's content of that node; the Inherit attribute itself is dropped.",
  "game_version": "1.6.4871",
  "mods": [
   {
    "id": "ludeon.rimworld",
    "files": {
     "Defs/a.xml": "<Defs><ThingDef Name=\"P\" Abstract=\"True\"><comps><li>a</li><li>b</li></comps><statBases><A>1</A></statBases></ThingDef><ThingDef ParentName=\"P\"><defName>C</defName><comps Inherit=\"False\"><li>z</li></comps><statBases Inherit=\"false\"><B>2</B></statBases></ThingDef></Defs>"
    }
   }
  ],
  "expect": {
   "defs": {
    "ThingDef/C": "<ThingDef ParentName=\"P\"><comps><li>z</li></comps><statBases><B>2</B></statBases><defName>C</defName></ThingDef>"
   }
  }
 },
 {
  "name": "inherit-false-root-keeps-parent-attrs",
  "doc": "Quirk: with Inherit=\"false\" on the def node the cloned parent's attributes survive (Name, Abstract) and the child's are appended.",
  "game_version": "1.6.4871",
  "mods": [
   {
    "id": "ludeon.rimworld",
    "files": {
     "Defs/a.xml": "<Defs><ThingDef Name=\"P\" Abstract=\"True\"><label>p</label><x>1</x></ThingDef><ThingDef ParentName=\"P\" Inherit=\"false\"><defName>C</defName></ThingDef></Defs>"
    }
   }
  ],
  "expect": {
   "defs": {
    "ThingDef/C": "<ThingDef Name=\"P\" Abstract=\"True\" ParentName=\"P\"><defName>C</defName></ThingDef>"
   }
  }
 },
 {
  "name": "inherit-empty-element",
  "doc": "An empty child element: removes the parent's text (no element children) but keeps the parent's element children.",
  "game_version": "1.6.4871",
  "mods": [
   {
    "id": "ludeon.rimworld",
    "files": {
     "Defs/a.xml": "<Defs><ThingDef Name=\"P\" Abstract=\"True\"><label>x</label><statBases><A>1</A></statBases><tags><li>t</li></tags></ThingDef><ThingDef ParentName=\"P\"><defName>C</defName><label/><statBases/><tags></tags></ThingDef></Defs>"
    }
   }
  ],
  "expect": {
   "defs": {
    "ThingDef/C": "<ThingDef ParentName=\"P\"><label/><statBases><A>1</A></statBases><tags><li>t</li></tags><defName>C</defName></ThingDef>"
   }
  }
 },
 {
  "name": "inherit-text-over-multichild-quirk",
  "doc": "Quirk (Mono probe): a child that holds text replaces the parent's content, but only the FIRST child node of the parent is removed (live list).",
  "game_version": "1.6.4871",
  "mods": [
   {
    "id": "ludeon.rimworld",
    "files": {
     "Defs/a.xml": "<Defs><ThingDef Name=\"P\" Abstract=\"True\"><x><a/><b/><c/></x></ThingDef><ThingDef ParentName=\"P\"><defName>C</defName><x>t</x></ThingDef></Defs>"
    }
   }
  ],
  "expect": {
   "defs": {
    "ThingDef/C": "<ThingDef ParentName=\"P\"><x><b/><c/>t</x><defName>C</defName></ThingDef>"
   }
  }
 },
 {
  "name": "inherit-chain-three-levels",
  "doc": "Grandparent, parent, child in any file order: resolved top-down; the parent chain is recorded.",
  "game_version": "1.6.4871",
  "mods": [
   {
    "id": "ludeon.rimworld",
    "files": {
     "Defs/a.xml": "<Defs><ThingDef ParentName=\"P\"><defName>C</defName><c>c</c></ThingDef><ThingDef Name=\"P\" ParentName=\"G\" Abstract=\"True\"><b>p</b></ThingDef><ThingDef Name=\"G\" Abstract=\"True\"><a>g</a><b>g</b><c>g</c></ThingDef></Defs>"
    }
   }
  ],
  "expect": {
   "defs": {
    "ThingDef/C": "<ThingDef ParentName=\"P\"><a>g</a><b>p</b><c>c</c><defName>C</defName></ThingDef>"
   },
   "provenance": {
    "ThingDef/C": {
     "parents": [
      "ludeon.rimworld:P",
      "ludeon.rimworld:G"
     ]
    }
   }
  }
 },
 {
  "name": "inherit-cycle",
  "doc": "A cycle is reported for every member; the members stay unresolved and the defs are built from the raw nodes (with a not-resolved error each).",
  "game_version": "1.6.4871",
  "mods": [
   {
    "id": "ludeon.rimworld",
    "files": {
     "Defs/a.xml": "<Defs><ThingDef Name=\"A\" ParentName=\"B\"><defName>DA</defName></ThingDef><ThingDef Name=\"B\" ParentName=\"A\"><defName>DB</defName></ThingDef><ThingDef><defName>N</defName></ThingDef></Defs>"
    }
   }
  ],
  "expect": {
   "defs": {
    "ThingDef/DA": "<ThingDef Name=\"A\" ParentName=\"B\"><defName>DA</defName></ThingDef>"
   },
   "diag": {
    "inherit_cycle": 2,
    "inherit_not_resolved": 2
   },
   "stats": {
    "defs": 3
   }
  }
 },
 {
  "name": "inherit-missing-parent",

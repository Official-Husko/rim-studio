    "files": {
     "Defs/a.xml": "<Defs><ThingDef ParentName=\"Nope\"><defName>M</defName></ThingDef></Defs>"
    }
   }
  ],
  "expect": {
   "defs": {
    "ThingDef/M": "<ThingDef ParentName=\"Nope\"><defName>M</defName></ThingDef>"
   },
   "diag": {
    "inherit_missing_parent": 1,
    "inherit_not_resolved": 0
   }
  }
 },
 {
  "name": "inherit-parent-by-load-order",
  "doc": "A child sees the parent with the highest load order that is not after its own mod; a parent that only exists in a LATER mod is invisible.",
  "game_version": "1.6.4871",
  "mods": [
   {
    "id": "ludeon.rimworld",
    "files": {
     "Defs/a.xml": "<Defs><ThingDef ParentName=\"P\"><defName>InCore</defName></ThingDef></Defs>"
    }
   },
   {
    "id": "test.a",
    "files": {
     "Defs/a.xml": "<Defs><ThingDef Name=\"P\" Abstract=\"True\"><label>A</label></ThingDef></Defs>"
    }
   },
   {
    "id": "test.b",
    "files": {
     "Defs/a.xml": "<Defs><ThingDef ParentName=\"P\"><defName>InB</defName></ThingDef></Defs>"
    }
   },
   {
    "id": "test.c",
    "files": {
     "Defs/a.xml": "<Defs><ThingDef Name=\"P\" Abstract=\"True\"><label>C</label></ThingDef><ThingDef ParentName=\"P\"><defName>InC</defName></ThingDef></Defs>"
    }
   }
  ],
  "expect": {
   "defs": {
    "ThingDef/InB": "<ThingDef ParentName=\"P\"><label>A</label><defName>InB</defName></ThingDef>",
    "ThingDef/InC": "<ThingDef ParentName=\"P\"><label>C</label><defName>InC</defName></ThingDef>",
    "ThingDef/InCore": "<ThingDef ParentName=\"P\"><defName>InCore</defName></ThingDef>"
   },
   "diag": {
    "inherit_missing_parent": 1
   }
  }
 },
 {
  "name": "inherit-duplicate-name-same-mod",
  "doc": "A Name used twice inside one mod: the second is not registered (error); the same Name in another mod is fine and wins for that mod's children.",
  "game_version": "1.6.4871",
  "mods": [
   {
    "id": "test.a",
    "files": {
     "Defs/a.xml": "<Defs><ThingDef Name=\"X\" Abstract=\"True\"><label>1</label></ThingDef><ThingDef Name=\"X\" Abstract=\"True\"><label>2</label></ThingDef><ThingDef ParentName=\"X\"><defName>CA</defName></ThingDef></Defs>"
    }
   },
   {
    "id": "test.b",
    "files": {
     "Defs/a.xml": "<Defs><ThingDef Name=\"X\" Abstract=\"True\"><label>3</label></ThingDef><ThingDef ParentName=\"X\"><defName>CB</defName></ThingDef></Defs>"
    }
   }
  ],
  "expect": {
   "defs": {
    "ThingDef/CA": "<ThingDef ParentName=\"X\"><label>1</label><defName>CA</defName></ThingDef>",
    "ThingDef/CB": "<ThingDef ParentName=\"X\"><label>3</label><defName>CB</defName></ThingDef>"
   },
   "diag": {
    "inherit_duplicate_name": 1
   }
  }
 },

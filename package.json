{
  "name": "rimstudio-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "pnpm --filter rimstudio-desktop dev",
    "gallery": "pnpm --filter rimstudio-desktop gallery",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm --filter rimstudio-desktop build",
    "lint": "oxlint -c .oxlintrc.json apps packages tests/e2e",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json,html}\" \"packages/ui/**/*.{ts,tsx,json}\" \"packages/testkit/**/*.{ts,tsx,json}\" \"*.json\" README.md",
    "check": "pnpm typecheck && pnpm test && pnpm lint",
    "e2e": "pnpm --filter rimstudio-e2e e2e",
    "tauri:dev": "node scripts/tauri.mjs dev",
    "tauri:build": "node scripts/tauri.mjs build",
    "tauri:check": "node scripts/tauri.mjs check",
    "tauri:smoke": "node scripts/tauri.mjs smoke"
  },
  "devDependencies": {
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
